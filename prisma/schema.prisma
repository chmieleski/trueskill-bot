// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id          String   @id // e.g. "warcraft3_udbr"
  displayName String
  leagues     League[]
  events      Event[]
  players     Player[]
  items       GameItem[]
  heroes      GameHero[]
}

model GameHero {
  gameId    String
  objectId  Int
  name      String
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, objectId])
  @@index([gameId])
}

model GameItem {
  gameId    String
  objectId  Int
  name      String
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, objectId])
  @@index([gameId])
}

model League {
  id                      String   @id @default(cuid())
  guildId                 String
  gameId                  String
  name                    String
  wc3statsEnabled         Boolean  @default(false)
  wc3statsMapPattern      String?
  wc3statsMapSha1         String?
  leaderboardChannelId    String?
  leaderboardMessageId    String?
  leaderboardSize               Int      @default(10)
  lobbyPlayerClaimEnabled       Boolean  @default(true)
  wc3statsHostPromptEnabled     Boolean  @default(false)
  wc3statsHostPromptChannelId   String?
  rankResetEnabled              Boolean  @default(false)
  rankResetCooldownDays         Int      @default(30)
  /// When true, /rank shows per-side (team 1 / team 2) W–L under the overall record.
  showSideWinLoss               Boolean  @default(false)
  lobbyChannelEnabled           Boolean  @default(false)
  lobbyChannelId                String?
  status                        LeagueStatus @default(ACTIVE)
  predecessorLeagueId           String?
  archivedAt                    DateTime?
  decayEnabled                  Boolean  @default(true)
  balanceStaticSigmaEnabled     Boolean  @default(false)
  seasonEndsAt                  DateTime?
  crunchStartedAt               DateTime?
  // Nullable overrides — null means use code defaults in decay-settings.ts
  decayMidGraceDays             Int?
  decayMidTier1Ki               Int?
  decayMidTier2Ki               Int?
  decayMidTier1SpanDays         Int?
  decayMidStreakCapKi           Int?
  decayCrunchGraceDays          Int?
  decayCrunchTier1Ki            Int?
  decayCrunchTier2Ki            Int?
  decayCrunchTier1SpanDays      Int?
  decayCrunchWindowDays         Int?
  decayPrizeLockEnabled         Boolean?
  decayPrizeLockMinGames        Int?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  game              Game                    @relation(fields: [gameId], references: [id])
  channelBindings   LeagueChannelBinding[]
  matches           Match[]
  ratings           PlayerRating[]
  heroRatings       PlayerHeroRating[]
  rankResets        PlayerRankReset[]
  wc3statsSlotMaps  LeagueWc3statsSlotMap[]
  predecessor       League?                 @relation("LeagueSuccession", fields: [predecessorLeagueId], references: [id])
  successors        League[]                @relation("LeagueSuccession")
  rolloverDrafts    LeagueRolloverDraft[]

  @@unique([guildId, gameId, name])
  @@index([guildId])
  @@index([gameId])
}

// LeagueWc3statsSlotMap - map wc3stats slots[] index → bot hero/slot (1-12) per league
// Unmapped indices are skipped (e.g. Referee). Empty league map → legacy index+1 for 0-11.
model LeagueWc3statsSlotMap {
  leagueId     String
  wc3statsSlot Int // 0-based index in wc3stats detail.slots
  heroId       Int // 1-12 (lobby slot / hero id)

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@id([leagueId, wc3statsSlot])
  @@index([leagueId])
  @@index([leagueId, heroId])
}

model LeagueChannelBinding {
  leagueId  String
  discordId String
  kind      LeagueBindingKind

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@id([discordId])
  @@index([leagueId])
}

enum LeagueBindingKind {
  CHANNEL
  CATEGORY
}

enum LeagueStatus {
  ACTIVE
  ARCHIVED
}

enum EventStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EventBindingKind {
  CHANNEL
  CATEGORY
}

// Event - guild+game container for unrated tournament/scrim matches (sibling to League)
model Event {
  id        String      @id @default(cuid())
  guildId   String
  gameId    String
  name      String
  status    EventStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  game            Game                   @relation(fields: [gameId], references: [id])
  channelBindings EventChannelBinding[]
  matches         Match[]

  @@index([guildId])
  @@index([gameId])
  @@index([guildId, gameId])
}

model EventChannelBinding {
  eventId   String
  discordId String
  kind      EventBindingKind

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([discordId])
  @@index([eventId])
}

model LeagueRolloverDraft {
  id               String   @id @default(cuid())
  sourceLeagueId   String
  successorName    String
  resetMode        String   // "hard" | "soft"
  compression      Float?
  actorDiscordId   String
  createdAt        DateTime @default(now())

  sourceLeague League @relation(fields: [sourceLeagueId], references: [id], onDelete: Cascade)

  @@index([sourceLeagueId, actorDiscordId, createdAt])
}

model Player {
  id                             String             @id @default(uuid())
  gameId                         String
  username                       String
  discordId                      String?
  wc3statsHostPromptPingsEnabled Boolean            @default(true)
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt
  game                           Game               @relation(fields: [gameId], references: [id])
  matches                        MatchPlayer[]
  ratings                        PlayerRating[]
  heroRatings                    PlayerHeroRating[]
  rankResets                     PlayerRankReset[]
  ratingSnapshots                MatchRatingSnapshot[]
  matchStats                     MatchPlayerStats[]

  @@unique([gameId, username])
  @@unique([gameId, discordId])
  @@index([gameId])
  @@index([username])
  @@index([discordId])
}

// PlayerRating - League-scoped skill rating (OpenSkill μ/σ)
// PK is (leagueId, playerId) — ratings are isolated per league
model PlayerRating {
  leagueId  String
  playerId  String
  mu          Float    @default(25.0)
  sigma       Float    @default(8.333)
  isNewPlayer              Boolean   @default(false)
  lastQualifyingActivityAt DateTime?
  idleDecayKiApplied       Int       @default(0)
  lastDecayAppliedAt       DateTime?
  updatedAt                DateTime  @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([leagueId, playerId])
  @@index([leagueId])
}

// Hero - 12 unique heroes tied to lobby slots (1-12). Managed in the database (no app seed).
model Hero {
  id          Int                @id // 1-12, matches slot number
  name        String             @unique
  color       String? // Lobby color name (e.g., "Red", "Blue")
  heroRatings PlayerHeroRating[]

  @@index([name])
}

// PlayerHeroRating - League-scoped hero-specific skill tracking (Cold Start solution)
// PK is (leagueId, playerId, heroId) — ratings are isolated per league
model PlayerHeroRating {
  leagueId      String
  playerId      String
  heroId        Int
  mu            Float    @default(25.0)
  sigma         Float    @default(8.333)
  matchesPlayed Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  hero   Hero   @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@id([leagueId, playerId, heroId])
  @@index([leagueId, playerId])
  @@index([leagueId, heroId])
}

model PlayerRankReset {
  id              String   @id @default(cuid())
  leagueId        String
  playerId        String
  actorDiscordId  String
  targetDiscordId String?
  staffOverride   Boolean  @default(false)
  createdAt       DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([leagueId, playerId, createdAt])
  @@index([leagueId, createdAt])
}

// Match - up to 6v6 game session (unbalanced human fills allowed).
// Exactly one of leagueId (IHL rated) or eventId (unrated Event) must be set (DB check).
model Match {
  id               String        @id @default(cuid())
  status           MatchStatus   @default(PENDING)
  hostDiscordId    String
  discordChannelId String
  discordMessageId String?       @unique
  wc3statsGameId   String?
  /// Last screenshot upload or manual roster edit; wc3stats Refresh must beat this.
  lobbyRosterAuthorityAt DateTime?
  leagueId         String?
  eventId          String?
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  league           League?       @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  event            Event?        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  players          MatchPlayer[]
  ratingSnapshots  MatchRatingSnapshot[]
  statsReport      MatchStatsReport?

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([hostDiscordId])
  @@index([wc3statsGameId])
  @@index([leagueId, status])
  @@index([leagueId, wc3statsGameId])
  @@index([leagueId, completedAt])
  @@index([eventId, status])
  @@index([eventId, completedAt])
}

// MatchPlayer - Player participation in a match
model MatchPlayer {
  matchId   String
  playerId  String
  team      Int // 1 or 2 (from game profile teamForSlot; not a fixed slot cutoff)
  slot      Int // 1..profile.slotCount (absolute lobby position; team from profile)
  heroId    Int? // slot_bound: equals slot; optional_in_game: null until pick (phase 2)
  result    MatchResult? // Null until match ends
  isQuitter Boolean      @default(false) // Quitter penalty flag; excluded from team rating
  isGriefer Boolean      @default(false) // Bug-abuse penalty flag; stays in team rating
  /// Soft lock: balance hints + shuffle leave this player↔slot pair alone.
  locked Boolean @default(false)
  /// Deferred global ki tax for this griefer incident (null when not griefer).
  grieferKiAccrued Int?
  wasNewPlayer Boolean      @default(false) // Snapshot of PlayerRating.isNewPlayer at rating apply
  /// Display ki after this match (null until completed with preview written).
  globalKi      Int?
  /// after − before global display ki for this match.
  globalKiDelta Int?
  /// Hero display ki after this match (null when no hero / not written).
  heroKi        Int?
  /// after − before hero display ki for this match.
  heroKiDelta   Int?

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  stats  MatchPlayerStats?

  @@id([matchId, playerId])
  @@index([matchId])
  @@index([playerId])
}

model MatchStatsReport {
  id                  String   @id @default(cuid())
  matchId             String   @unique
  format              String
  externalId          String   @unique
  rawText             String   @db.Text
  team1Rounds         Int?
  team2Rounds         Int?
  playerCount         Int?
  uploadedAt          DateTime @default(now())
  uploadedByDiscordId String

  match       Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerStats MatchPlayerStats[]
}

model MatchPlayerStats {
  matchId      String
  playerId     String
  reportIndex  Int
  reportPid    Int
  reportWin    Boolean?
  kills        Int
  deaths       Int
  damagePhys   Int
  damageMagic  Int
  damageTotal  Int
  heal         Int
  takenPhys    Int
  takenMagic   Int
  takenTotal   Int
  heroObjectId Int?
  heroName     String?
  itemSlot1    Int      @default(0)
  itemSlot2    Int      @default(0)
  itemSlot3    Int      @default(0)
  itemSlot4    Int      @default(0)
  itemSlot5    Int      @default(0)
  itemSlot6    Int      @default(0)

  matchPlayer MatchPlayer      @relation(fields: [matchId, playerId], references: [matchId, playerId], onDelete: Cascade)
  player      Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  report      MatchStatsReport @relation(fields: [matchId], references: [matchId], onDelete: Cascade)

  @@id([matchId, playerId])
  @@index([matchId])
}

enum MatchRatingEntityKind {
  GLOBAL
  HERO
}

model MatchRatingSnapshot {
  id            String                @id @default(cuid())
  matchId       String
  playerId      String
  entityKind    MatchRatingEntityKind
  /// For GLOBAL use sentinel `0`. For HERO use the slot hero id (1–12 for UDBR).
  heroId        Int
  mu            Float
  sigma         Float
  matchesPlayed Int?
  createdAt     DateTime              @default(now())

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId, entityKind, heroId])
  @@index([matchId])
}

enum MatchStatus {
  PENDING // Lobby created, waiting for players
  IN_PROGRESS // Match started
  COMPLETED // Match finished with results
  CANCELLED // Match cancelled before completion
}

enum MatchResult {
  WIN
  LOSS
  DRAW // Not used in game mechanics, kept for future flexibility
}

enum QuitterLeaderboardDisplay {
  count
  rate
  both
}

enum QuitterLeaderboardSort {
  count
  rate
}

enum GrieferLeaderboardDisplay {
  count
  rate
  both
}

enum GrieferLeaderboardSort {
  count
  rate
}

// GuildConfig - per-server bot settings (roles, quitter leaderboard, changelog channels). IHL fields stay on League.
model GuildConfig {
  guildId                      String                     @id
  matchCreateRoleId            String?
  matchModRoleId               String?
  quitterLeaderboardChannelId  String?
  quitterLeaderboardMessageId  String?
  quitterLeaderboardSize       Int                        @default(10)
  quitterLeaderboardDisplay    QuitterLeaderboardDisplay  @default(both)
  quitterLeaderboardSort       QuitterLeaderboardSort     @default(count)
  grieferLeaderboardChannelId  String?
  grieferLeaderboardMessageId  String?
  grieferLeaderboardSize       Int                        @default(10)
  grieferLeaderboardDisplay    GrieferLeaderboardDisplay  @default(both)
  grieferLeaderboardSort       GrieferLeaderboardSort     @default(count)
  changelogChannelId           String?
  changelogDraftChannelId      String?
  completedMatchLogChannelId   String?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
}

enum BotReleaseStatus {
  draft
  published
  skipped
}

// Process-wide product version (not league-scoped). Staff draft → player fan-out.
model BotRelease {
  version           String           @id
  engineeringNotes  String
  playerNotes       String
  status            BotReleaseStatus @default(draft)
  draftGuildId      String?
  draftChannelId    String?
  draftMessageId    String?
  publishedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  posts             BotReleasePost[]
}

model BotReleasePost {
  version   String
  guildId   String
  channelId String
  messageId String
  release   BotRelease @relation(fields: [version], references: [version], onDelete: Cascade)

  @@id([version, guildId])
  @@index([guildId])
}
