{
  "name": "dbz-wc3-bot",
  "version": "0.1.0",
  "type": "module",
  "description": "Discord bot for managing DBZ Warcraft III 5v5 matches",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --clear-screen=false src/index.ts",
    "build": "prisma generate && tsc",
    "start": "NODE_ENV=production node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "discord",
    "bot",
    "warcraft3",
    "dragon-ball-z"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "discord.js": "^14.21.0",
    "dotenv": "^16.4.7",
    "pg": "^8.23.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.21.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true
  }
}
