{
  "name": "dbz-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@dbz/bot",
    "dev:web": "turbo run dev --filter=@dbz/web",
    "dev:bot": "turbo run dev --filter=@dbz/bot",
    "build": "turbo run build",
    "build:bot": "turbo run build --filter=@dbz/bot",
    "build:web": "turbo run build --filter=@dbz/web",
    "start": "pnpm --filter @dbz/bot start",
    "deploy-commands": "pnpm --filter @dbz/bot deploy-commands",
    "db:migrate": "pnpm --filter @dbz/db migrate:dev",
    "db:generate": "pnpm --filter @dbz/db generate",
    "db:push": "pnpm --filter @dbz/db push",
    "db:studio": "pnpm --filter @dbz/db studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:clone": "bash apps/bot/scripts/db-clone-local.sh",
    "db:clone:heroes": "bash apps/bot/scripts/db-clone-local.sh --heroes-only",
    "db:backup": "bash apps/bot/scripts/db-backup.sh",
    "db:restore": "bash apps/bot/scripts/db-restore-local.sh",
    "db:migrate-multi-league": "pnpm --filter @dbz/bot db:migrate-multi-league",
    "seed:veterans": "pnpm --filter @dbz/bot seed:veterans",
    "test": "turbo run test --filter=@dbz/bot",
    "test:watch": "pnpm --filter @dbz/bot test:watch",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:bot": "bash deploy/aws/pack-release.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "turbo": "^2.5.4",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  }
}
