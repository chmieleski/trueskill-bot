# Copy to terraform.tfvars (gitignored) and fill in values.
# Requires: AWS credentials with rights to EC2, IAM, SSM, EIP.
# Tooling: OpenTofu (`tofu`) or Terraform (`terraform`) >= 1.6

aws_region   = "us-east-1" # Free Tier friendly; change if your account prefers another region
project_name = "dbz-bot"
environment  = "prod"

instance_type = "t3.micro" # or "t2.micro" if t3.micro is unavailable in the AZ

# Dynamic home IP? Keep SSH off and use Session Manager (recommended):
#   aws ssm start-session --target <instance_id>
enable_ssh = false
# ssh_cidr and ssh_public_key only needed if enable_ssh = true
# ssh_cidr      = "203.0.113.45/32"
# ssh_public_key = "ssh-ed25519 AAAA... comment"
key_pair_name = "dbz-bot"

# Public HTTPS clone URL, or private with PAT:
# https://<token>@github.com/org/dbz-wc3-bot.git
repo_url    = "https://github.com/YOUR_USER/YOUR_REPO.git"
repo_branch = "main"
# GitHub repo allowed to assume the deploy IAM role via OIDC (push to main only)
github_repository = "chmieleski/trueskill-bot"
# After `tofu apply`, set GitHub repo variable RELEASE_BUCKET to output release_bucket_name
app_dir     = "/home/ubuntu/bot"

deploy_commands_on_boot = true
allocate_eip            = true

# Database: AWS RDS PostgreSQL (cheapest way: Single-AZ db.t4g.micro / 20 GB gp3)
# To migrate from Supabase to AWS RDS:
# 1. Keep use_rds_for_bot = false while running `tofu apply` (creates RDS alongside current bot).
# 2. Run the migration script: `npm run db:migrate-aws` to copy all data from Supabase to RDS.
# 3. Set use_rds_for_bot = true and run `tofu apply` + refresh host env to cut over.
enable_rds      = true
use_rds_for_bot = false # Set true once migrated to switch bot DATABASE_URL to RDS
# db_instance_class     = "db.t4g.micro" # Free Tier eligible, ~$0.016/hr
# db_allocated_storage  = 20             # 20 GB (minimum for Postgres, Free Tier limit)
# db_name               = "dbzbot"
# db_username           = "postgres"
# db_password           = "leave-blank-to-auto-generate-secure-password"

# Secrets → SSM Parameter Store (also stored in Terraform state — keep state private)
discord_token  = "your_discord_bot_token"
client_id      = "your_discord_application_id"
# Empty = global slash command deploy (recommended for production multi-guild)
guild_id       = ""
# External / Supabase URLs (used when use_rds_for_bot = false)
database_url   = "postgresql://..."
direct_url     = "postgresql://..."
gemini_api_key = "your_gemini_api_key"

# Optional env fallbacks (empty string = unset / disabled)
match_create_role_id = ""
match_mod_role_id    = ""
log_level            = "info"

# wc3stats lobby import is enabled per server with /config set wc3stats_map_preset.
wc3stats_timeout_ms = "4000"

# W/L display: history (default) | counters (after shadow verify)
# display_stats_source = "history"

# HTTP API (WOS match ingest). Off by default.
# api_enabled        = "false"
# api_port           = "8787"
# api_bind           = "0.0.0.0"
# enable_api_ingress = false
# api_ingress_cidr   = "127.0.0.1/32"

# Process observability (Discord ops + agent HTTP). On by default; bind loopback.
# obs_enabled             = "true"
# obs_bind                = "127.0.0.1"
# obs_port                = "8790"
# obs_token               = ""
# ops_alert_channel_id    = ""
# obs_rss_mb_warn         = "512"
# obs_event_loop_ms_warn  = "200"
# obs_sample_interval_ms  = "15000"
