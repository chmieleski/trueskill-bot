# Copy to terraform.tfvars (gitignored) and fill in values.
# Requires: AWS credentials with rights to EC2, IAM, SSM, EIP.
# Tooling: OpenTofu (`tofu`) or Terraform (`terraform`) >= 1.6

aws_region   = "us-east-1" # Free Tier friendly; change if your account prefers another region
project_name = "dbz-bot"
environment  = "prod"

instance_type = "t3.micro" # or "t2.micro" if t3.micro is unavailable in the AZ

# Dynamic home IP? Keep SSH off and use Session Manager (recommended):
#   aws ssm start-session --target <instance_id>
enable_ssh = false
# ssh_cidr and ssh_public_key only needed if enable_ssh = true
# ssh_cidr      = "203.0.113.45/32"
# ssh_public_key = "ssh-ed25519 AAAA... comment"
key_pair_name = "dbz-bot"

# Public HTTPS clone URL, or private with PAT:
# https://<token>@github.com/org/dbz-wc3-bot.git
repo_url    = "https://github.com/YOUR_USER/YOUR_REPO.git"
repo_branch = "main"
# GitHub repo allowed to assume the deploy IAM role via OIDC (push to main only)
github_repository = "chmieleski/trueskill-bot"
app_dir     = "/home/ubuntu/bot"

deploy_commands_on_boot = true
allocate_eip            = true

# Secrets → SSM Parameter Store (also stored in Terraform state — keep state private)
discord_token  = "your_discord_bot_token"
client_id      = "your_discord_application_id"
guild_id       = "your_discord_guild_id"
database_url   = "postgresql://..."
direct_url     = "postgresql://..."
gemini_api_key = "your_gemini_api_key"

# Optional env fallbacks (empty string = unset / disabled)
match_create_role_id = ""
match_mod_role_id    = ""
log_level            = "info"

# wc3stats lobby import (leave enabled=false until ready in prod)
wc3stats_enabled     = "false"
wc3stats_map_pattern = "ultimate.?dragon.?ball.?reborn|udbr"
wc3stats_map_sha1    = "19783c6259e86253a8c940ede63a87e18204bd94"
wc3stats_timeout_ms  = "4000"
