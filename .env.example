DISCORD_TOKEN=your_token_here
CLIENT_ID=your_discord_application_id
GUILD_ID=your_dev_server_id

# Supabase PostgreSQL connection strings
# Get from: Supabase Dashboard → Project Settings → Database
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Local Docker Postgres (docker compose up -d — host port 5433)
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/dbzbot?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/dbzbot?schema=public"
# Hosted session/direct URL (5432) used only by npm run db:clone — never 6543
# PROD_DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# development (npm run dev) | production (npm run build && npm start)
# NODE_ENV=development

# Register slash commands on startup (default: true in dev, false in production)
# AUTO_DEPLOY_COMMANDS=true

# Google Gemini API key (lobby screenshot OCR via /register_lobby)
GEMINI_API_KEY=your_gemini_api_key_here

# Log level: fatal | error | warn | info | verbose | debug | trace
# Defaults: debug in development, info in production
# LOG_LEVEL=debug

# Fallback Discord role IDs until each is set per-server with /config set …
# After /config set create_role|mod_role, the database value wins for that guild.
# Empty create fallback = nobody can /register_lobby until configured.
# Empty mod fallback = host-only manage until configured.
# MATCH_CREATE_ROLE_ID=
# MATCH_MOD_ROLE_ID=

# wc3stats lobby import (default off). SHA-1 is gamelist/{id} map.sha1, NOT the list `hash`.
# Confirmed live UDBR 2.4f: Maps/Download/Ultimate Dragonball Reborn V2.4f.w3x
# WC3STATS_ENABLED=false
# WC3STATS_MAP_PATTERN=ultimate.?dragon.?ball.?reborn|udbr
# WC3STATS_MAP_SHA1=19783c6259e86253a8c940ede63a87e18204bd94
# WC3STATS_TIMEOUT_MS=4000
