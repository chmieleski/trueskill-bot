DISCORD_TOKEN=your_token_here
CLIENT_ID=your_discord_application_id
# Optional: guild-scoped command deploy for faster dev iteration. Omit or leave empty for global deploy.
GUILD_ID=your_dev_server_id
# Discord guild that owns pre-multi-league Match/rating history (npm run db:migrate-multi-league). Defaults to GUILD_ID.
# MULTI_LEAGUE_LEGACY_GUILD_ID=your_prod_server_id

# Supabase PostgreSQL connection strings
# Get from: Supabase Dashboard → Project Settings → Database
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Local Docker Postgres (docker compose up -d — host port 5433)
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/dbzbot?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/dbzbot?schema=public"
# Hosted session/direct URL (5432) used only by npm run db:clone — never 6543
# PROD_DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# development (npm run dev) | production (npm run build && npm start)
# NODE_ENV=development

# Register slash commands on startup (default: true in dev, false in production)
# AUTO_DEPLOY_COMMANDS=true

# Google Gemini API key (lobby screenshot OCR via /register_lobby)
GEMINI_API_KEY=your_gemini_api_key_here

# Log level: fatal | error | warn | info | verbose | debug | trace
# Defaults: debug in development, info in production
# LOG_LEVEL=debug

# Fallback Discord role IDs until each is set per-server with /config set …
# After /config set create_role|mod_role, the database value wins for that guild.
# Empty create fallback = nobody can /register_lobby until configured.
# Empty mod fallback = host-only manage until configured.
# MATCH_CREATE_ROLE_ID=
# MATCH_MOD_ROLE_ID=

# wc3stats lobby import is enabled per server with /config set wc3stats_map_preset.
# WC3STATS_TIMEOUT_MS=4000

# HTTP API (WOS match ingest). Off by default.
API_ENABLED=false
API_PORT=8787
API_BIND=0.0.0.0

# Process observability (Discord ops alerts + agent HTTP /health /status). On by default.
# OBS_ENABLED=true
# OBS_BIND=127.0.0.1
# OBS_PORT=8790
# Required when OBS_BIND is not loopback:
# OBS_TOKEN=
# Process-wide ops alert channel (also /config set ops_channel per guild):
# OPS_ALERT_CHANNEL_ID=
# OBS_RSS_MB_WARN=512
# OBS_EVENT_LOOP_MS_WARN=200
# OBS_SAMPLE_INTERVAL_MS=15000

# Local-only: ClickUp personal API token for agents when the ClickUp MCP is rate-limited.
# Not read by the bot. Do not add to AWS SSM.
# CLICKUP_API_TOKEN=pk_...
