{
  "name": "@dbz/bot",
  "version": "1.60.4",
  "private": true,
  "type": "module",
  "description": "Discord bot for managing DBZ Warcraft III ranked matches",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --clear-screen=false src/index.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/index.js",
    "deploy-commands": "node dist/deploy-commands.js",
    "db:migrate-multi-league": "tsx scripts/migrate-multi-league.ts",
    "seed:veterans": "tsx scripts/seed-veteran-ratings.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dbz/db": "workspace:*",
    "@google/genai": "^2.16.0",
    "@prisma/adapter-pg": "^7.9.1",
    "discord.js": "^14.21.0",
    "dotenv": "^16.4.7",
    "openskill": "5.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.21.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
